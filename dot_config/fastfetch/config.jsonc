{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "arch"
        // "source": "~/.config/fastfetch/mylogo.txt",
        // "padding": {
        //     "left": 4,
        //     "right": 4
        // },
        // "color": {
        //     "1": "#808080",
        //     "2": "#ffffff"
        // }
    },
    "display": {
        "color": {
            "keys": "#ffc400",
            "title": "#ffc400"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "command",
            "text": "date",
            "key": "Time",
            "keyWidth": 9
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyWidth": 10,
            "keyColor": "#ffc402"
        },
        "break",
        {
            "type": "uptime",
            "keyWidth": 9,
            "format": "{days} days, {hours} hours, {minutes} mins [{boot-time}]"
        },
        {
            "type": "os",
            "keyWidth": 9
        },
        {
            "type": "host",
            "keyWidth": 9
        },
        "break",
        {
            "type": "kernel",
            "keyWidth": 11,
            "keyColor": "cyan"
        },
        {
            "type": "command",
            "text": "python ~/.config/fastfetch/systemctl-unit-stats.py",
            "key": "systemd",
            "keyWidth": 11,
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "keyWidth": 11,
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "cpu",
            "keyColor": "#ff991c",
            "keyWidth": 8
        },
        {
            "type": "gpu",
            "keyColor": "#ff991c",
            "keyWidth": 8
        },
        "break",
        {
            "type": "memory",
            "key": "RAM",
            "keyWidth": 7,
            "keyColor": "#47b300",
            "percent": {
                "type": 3
            }
        },
        {
            "type": "swap",
            "keyWidth": 7,
            "keyColor": "#47b300",
            "percent": {
                "type": 3
            }
        },
        "break",
        {
            "type": "disk",
            "keyColor": "blue"
        },
        {
            "type": "localip",
            "key": "Local IP",
            "keyColor": "blue",
            "showIpv6": true,
            "showSpeed": true
        },
        "poweradapter"
    ]
}
