umask 0027

# XDG Base Directory Specification
# I prefer to set default values explicitly
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_STATE_HOME="${HOME}/.local/state"
export XDG_BIN_HOME="${HOME}/.local/bin"

# zsh dotfile dir, storing everything under $XDG_CONFIG_HOME is a little dirty
export ZDOTDIR="${XDG_CONFIG_HOME}/zsh"

# Other personal settings
export EDITOR=/usr/bin/vim
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"
export TMUX_TMPDIR="${XDG_RUNTIME_DIR}/tmux-tmpdir"

###              Homebrew environment variables               ###
# output of  `/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh` #
if [ -d "/home/linuxbrew/.linuxbrew" ] && [ "$(basename "${SHELL}")" = "zsh" ]
then
    export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew";
    export HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar";
    export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew";
    # fpath[1,0]="/home/linuxbrew/.linuxbrew/share/zsh/site-functions";
    export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin${PATH+:$PATH}";
    [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}";
    export INFOPATH="/home/linuxbrew/.linuxbrew/share/info:${INFOPATH:-}";
fi
#                                                                #
###             End Homebrew environment variables             ###

## Create some directories in ${XDG_RUNTIME_DIR} for future use

USER_RUNTIME_DIRS=(
    "ssh-host-sockets"
    "tmux-tmpdir"
)
for USER_DIR in "${USER_RUNTIME_DIRS[@]}"
do
    if [ ! -d "${XDG_RUNTIME_DIR}/${USER_DIR}" ]
    then
        mkdir "${XDG_RUNTIME_DIR}/${USER_DIR}"
    fi
done
unset USER_RUNTIME_DIRS
unset USER_DIR

# I'm setting $PATH last to potentially override anything just for myself
export PATH="${XDG_BIN_HOME}:${PATH}"
