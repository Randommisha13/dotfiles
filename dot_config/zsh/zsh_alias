#==============================================
# Aliases
#==============================================
alias ls='ls --color=auto'
alias grep='grep --color=auto'

alias difu='diff -u'
alias sc-reboot-windows='systemctl reboot --boot-loader-entry="auto-windows"'
alias sc-reboot-uefi='systemctl reboot --firmware-setup'

#==============================================
# Functions
#==============================================
cdreal() {
    if [ -n "${1}" ]
    then
        cd "$(realpath "${1}")"
    else
        cd "$(realpath "${PWD}")"
    fi
}
