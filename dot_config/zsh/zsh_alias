#==============================================
# Aliases
#==============================================
alias ls='ls --color=auto'
alias grep='grep --color=auto'

alias difu='diff -u'
alias sc-reboot-windows='systemctl reboot --boot-loader-entry="auto-windows"'
alias sc-reboot-uefi='systemctl reboot --firmware-setup'

alias :q="exit"
alias q="exit"
alias quit="exit"

#==============================================
# Functions
#==============================================
cdreal() {
    if [ -n "${1}" ]
    then
        cd "$(realpath "${1}")"
    else
        cd "$(realpath "${PWD}")"
    fi
}

tmux-change-tmpdir() {
    local valid_tmpdirs
    local new_tmpdir
    local query
    command -v "fzf" 2>/dev/null 1>/dev/null || {echo "fzf is not installed!"; exit 1}

    valid_tmpdirs=(
        "${XDG_RUNTIME_DIR}/tmux-tmpdir"
        "${XDG_RUNTIME_DIR}/tmux-tmpdir-kitty"
        "/tmp"
    )

    for dir in "${valid_tmpdirs[@]}"
    do
        query="${query}${dir}\n"
    done

    new_tmpdir="$(echo "${query}" | fzf)"

    export TMUX_TMPDIR="${new_tmpdir}"
}
